{
  "name": "@plain-agent/domain",
  "version": "0.1.0",
  "description": "Agent 核心：框架无关的 agent loop、工具、存储与历史压缩管理",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/cliExample.ts",
    "typecheck": "tsc --noEmit",
    "test:history": "tsx test/test-history.ts",
    "test:anchor": "tsx test/test-anchor.ts",
    "test:compression": "tsx test/test-smart-compression.ts",
    "test:mcp": "tsx test/test-mcp.ts",
    "test:jobs": "tsx test/test-job-persistence.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.4.3",
    "playwright-core": "^1.49.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
