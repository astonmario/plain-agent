{
  "name": "plain-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose AI agent with Electron + React + TypeScript + SQLite",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:core": "pnpm --filter @plain-agent/domain dev",
    "dev:cli": "pnpm --filter @plain-agent/cli dev",
    "dev:server": "pnpm --filter @plain-agent/server dev",
    "dev:desktop": "pnpm --filter @plain-agent/desktop dev",
    "cli": "pnpm --filter @plain-agent/cli dev",
    "server": "pnpm --filter @plain-agent/server start",
    "build": "pnpm --filter @plain-agent/desktop build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:web": "pnpm --filter @plain-agent/desktop typecheck:web",
    "test:history": "pnpm --filter @plain-agent/domain test:history",
    "test:anchor": "pnpm --filter @plain-agent/domain test:anchor",
    "test:compression": "pnpm --filter @plain-agent/domain test:compression",
    "test:subagent": "pnpm --filter @plain-agent/domain test:subagent",
    "test:subagent:e2e": "pnpm --filter @plain-agent/domain test:subagent:e2e"
  },
  "keywords": [
    "ai",
    "agent",
    "electron",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
