{
  "name": "plain-agent",
  "version": "0.1.0",
  "description": "A general-purpose AI agent with Electron + React + TypeScript + SQLite",
  "main": "out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev:core": "tsx src/agent-core/test.ts",
    "dev:cli": "tsx src/cli.ts",
    "dev:server": "tsx src/server.ts",
    "dev:desktop": "electron-vite dev",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "build": "tsc",
    "build:desktop": "electron-vite build",
    "preview:desktop": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest",
    "test:history": "tsx src/agent-core/test-history.ts",
    "test:anchor": "tsx src/agent-core/test-anchor.ts",
    "test:compression": "tsx src/agent-core/test-smart-compression.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "electron",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "iconv-lite": "^0.7.3",
    "openai": "^4.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-vite": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.7"
  }
}
